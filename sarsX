-- Tam Renk Enjeksiyonu Fonksiyonu
local function applyFullTheme(mainColor, textColor)
    pcall(function()
        for _, obj in ipairs(CoreGui:GetDescendants()) do
            if obj:IsA("UIStroke") then
                if obj.Color ~= Color3.fromRGB(0, 0, 0) and obj.Color ~= Color3.fromRGB(40, 40, 40) then
                    obj.Color = mainColor
                end
            elseif obj:IsA("Frame") or obj:IsA("ImageButton") or obj:IsA("ScrollingFrame") then
                local bg = obj.BackgroundColor3
                if (bg.R > 0.6 and bg.G > 0.5) or (bg == Color3.fromRGB(212, 175, 55)) then
                    obj.BackgroundColor3 = mainColor
                end
            elseif obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                if obj.TextColor3 ~= Color3.fromRGB(255, 255, 255) and obj.TextColor3 ~= Color3.fromRGB(0, 0, 0) then
                    obj.TextColor3 = textColor
                end
            end
        end
    end)
end

