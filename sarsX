-- TriggerBot Döngüsü
task.spawn(function()
    while task.wait(0.1) do
        pcall(function()
            if getgenv().XXSYSettings.TriggerBot then
                local mouse = LocalPlayer:GetMouse()
                local target = mouse.Target
                if target and target.Parent then
                    local character = target.Parent
                    local humanoid = character:FindFirstChild("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        local player = Players:GetPlayerFromCharacter(character)
                        if player and player ~= LocalPlayer then
                            task.wait(math.random(30, 80) / 1000)
                            mouse1click()
                            task.wait(0.2)
                        end
                    end
                end
            end
        end)
    end
end)

-- Ana Render Döngüsü
RunService.RenderStepped:Connect(function()
    pcall(function()
        local activeESPColor = getgenv().XXSYSettings.Rainbow and getRainbowColor() or getgenv().XXSYSettings.ESPColor
        local activeFOVColor = getgenv().XXSYSettings.Rainbow and getRainbowColor() or getgenv().XXSYSettings.FOVColor

        -- FOV Çemberi Güncelleme
        FOVFrame.Size = UDim2.new(0, getgenv().XXSYSettings.FOVRadius * 2, 0, getgenv().XXSYSettings.FOVRadius * 2)
        FOVFrame.Position = UDim2.new(0, Camera.ViewportSize.X / 2, 0, Camera.ViewportSize.Y / 2)
        FOVStroke.Color = activeFOVColor
        FOVGui.Enabled = getgenv().XXSYSettings.FOV

        -- Aimbot Mantığı (PC: Sağ Tık | Mobil: MobileAimbot Seçeneği Açıkken Direk Çalışır)
        local shouldAimbot = (getgenv().XXSYSettings.Aimbot and aimbotHolding) or getgenv().XXSYSettings.MobileAimbot

        if shouldAimbot then
            local closestTarget = nil
            local shortestDist = getgenv().XXSYSettings.FOVRadius
            local mousePos = UserInputService:GetMouseLocation()
            local cameraPos = Camera.CFrame.Position
            local localChar = LocalPlayer.Character

            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local char = player.Character
                    local humanoid = char:FindFirstChild("Humanoid")
                    local head = char:FindFirstChild("Head")
                    if humanoid and humanoid.Health > 0 and head then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                            if dist < shortestDist then
                                local rayParams = RaycastParams.new()
                                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                                rayParams.FilterDescendantsInstances = {localChar, char}
                                local rayResult = workspace:Raycast(cameraPos, head.Position - cameraPos, rayParams)
                                if not rayResult then
                                    shortestDist = dist
                                    closestTarget = head
                                end
                            end
                        end
                    end
                end
            end

            if closestTarget then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position)
            end
        end

        -- Kol / Silah Rainbow Efekti
        if getgenv().XXSYSettings.ArmRainbow then
            local char = LocalPlayer.Character
            local armCol = getRainbowColor()
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        local pName = part.Name
                        if pName:find("Arm") or pName:find("Hand") or pName:find("Tool") or pName:find("Handle") then
                            pcall(function() part.Color = armCol end)
                        end
                    end
                end
            end
        end

        -- ESP Görsellerini Güncelleme
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local data = espCache[player]
                if data and data.Character and data.Humanoid and data.RootPart and data.Head then
                    local isAlive = data.Humanoid.Health > 0
                    if not isAlive then
                        if data.Highlight then data.Highlight.Enabled = false end
                        if data.Billboard then data.Billboard.Enabled = false end
                        if data.Line then data.Line.Visible = false end
                        if data.BoxOutline then data.BoxOutline.Visible = false end
                        if data.BoxInline then data.BoxInline.Visible = false end
                        if data.HealthBarOutline then data.HealthBarOutline.Visible = false end
                        if data.HealthBarInline then data.HealthBarInline.Visible = false end
                        if data.SkeletonLines then
                            for _, line in pairs(data.SkeletonLines) do line.Visible = false end
                        end
                    else
                        if data.Highlight then
                            data.Highlight.Enabled = getgenv().XXSYSettings.ESP
                            data.Highlight.FillColor = activeESPColor
                        end
                        if data.Billboard then
                            data.Billboard.Enabled = getgenv().XXSYSettings.ESP and getgenv().XXSYSettings.Info
                            data.Text.TextColor3 = activeESPColor
                            if data.RootPart then
                                local dist = math.floor((Camera.CFrame.Position - data.RootPart.Position).Magnitude)
                                data.Text.Text = player.Name .. " [" .. math.floor(data.Humanoid.Health) .. "HP] - " .. dist .. "s"
                            end
                        end

                        -- Tracers
                        if data.Line then
                            if getgenv().XXSYSettings.ESP and getgenv().XXSYSettings.Tracers then
                                local vector, onScreen = Camera:WorldToViewportPoint(data.RootPart.Position)
                                if onScreen then
                                    data.Line.Visible = true
                                    data.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                                    data.Line.To = Vector2.new(vector.X, vector.Y)
                                    data.Line.Color = activeESPColor
                                else
                                    data.Line.Visible = false
                                end
                            else
                                data.Line.Visible = false
                            end
                        end

                        -- CS:GO Box & Can Barı
                        if data.BoxInline and data.BoxOutline then
                            if getgenv().XXSYSettings.ESP and getgenv().XXSYSettings.Box then
                                local rootPos, rootOnScreen = Camera:WorldToViewportPoint(data.RootPart.Position)
                                if rootOnScreen then
                                    local headPos = Camera:WorldToViewportPoint(data.Head.Position + Vector3.new(0, 0.5, 0))
                                    local legPos = Camera:WorldToViewportPoint(data.RootPart.Position - Vector3.new(0, 3, 0))
                                    
                                    local height = math.abs(headPos.Y - legPos.Y)
                                    local width = height / 2
                                    local size = Vector2.new(width, height)
                                    local pos = Vector2.new(rootPos.X - width / 2, headPos.Y)

                                    data.BoxOutline.Size = size
                                    data.BoxOutline.Position = pos
                                    data.BoxOutline.Visible = true

                                    data.BoxInline.Size = size
                                    data.BoxInline.Position = pos
                                    data.BoxInline.Color = activeESPColor
                                    data.BoxInline.Visible = true

                                    local healthFraction = math.clamp(data.Humanoid.Health / data.Humanoid.MaxHealth, 0, 1)
                                    local barHeight = height * healthFraction
                                    
                                    data.HealthBarOutline.From = Vector2.new(pos.X - 6, pos.Y + height)
                                    data.HealthBarOutline.To = Vector2.new(pos.X - 6, pos.Y)
                                    data.HealthBarOutline.Visible = true

                                    data.HealthBarInline.From = Vector2.new(pos.X - 6, pos.Y + height)
                                    data.HealthBarInline.To = Vector2.new(pos.X - 6, pos.Y + height - barHeight)
                                    data.HealthBarInline.Color = activeESPColor
                                    data.HealthBarInline.Visible = true
                                else
                                    data.BoxOutline.Visible = false
                                    data.BoxInline.Visible = false
                                    data.HealthBarOutline.Visible = false
                                    data.HealthBarInline.Visible = false
                                end
                            else
                                data.BoxOutline.Visible = false
                                data.BoxInline.Visible = false
                                data.HealthBarOutline.Visible = false
                                data.HealthBarInline.Visible = false
                            end
                        end

                        -- R6 Skeleton Çizimi
                        if data.SkeletonLines then
                            if getgenv().XXSYSettings.ESP and getgenv().XXSYSettings.Skeleton then
                                local char = data.Character
                                local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
                                local leftArm = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm")
                                local rightArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm")
                                local leftLeg = char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftUpperLeg")
                                local rightLeg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightUpperLeg")

                                if torso and data.Head then
                                    local headPos, headOn = Camera:WorldToViewportPoint(data.Head.Position)
                                    local torsoPos, torsoOn = Camera:WorldToViewportPoint(torso.Position)

                                    if headOn and torsoOn then
                                        data.SkeletonLines["Head_Torso"].From = Vector2.new(headPos.X, headPos.Y)
                                        data.SkeletonLines["Head_Torso"].To = Vector2.new(torsoPos.X, torsoPos.Y)
                                        data.SkeletonLines["Head_Torso"].Color = activeESPColor
                                        data.SkeletonLines["Head_Torso"].Visible = true
                                    else
                                        data.SkeletonLines["Head_Torso"].Visible = false
                                    end

                                    if leftArm then
                                        local laPos, laOn = Camera:WorldToViewportPoint(leftArm.Position)
                                        if torsoOn and laOn then
                                            data.SkeletonLines["LeftArm_Torso"].From = Vector2.new(torsoPos.X, torsoPos.Y)
                                            data.SkeletonLines["LeftArm_Torso"].To = Vector2.new(laPos.X, laPos.Y)
                                            data.SkeletonLines["LeftArm_Torso"].Color = activeESPColor
                                            data.SkeletonLines["LeftArm_Torso"].Visible = true
                                        else
                                            data.SkeletonLines["LeftArm_Torso"].Visible = false
                                        end
                                    end

                                    if rightArm then
                                        local raPos, raOn = Camera:WorldToViewportPoint(rightArm.Position)
                                        if torsoOn and raOn then
                                            data.SkeletonLines["RightArm_Torso"].From = Vector2.new(torsoPos.X, torsoPos.Y)
                                            data.SkeletonLines["RightArm_Torso"].To = Vector2.new(raPos.X, raPos.Y)
                                            data.SkeletonLines["RightArm_Torso"].Color = activeESPColor
                                            data.SkeletonLines["RightArm_Torso"].Visible = true
                                        else
                                            data.SkeletonLines["RightArm_Torso"].Visible = false
                                        end
                                    end

                                    if leftLeg then
                                        local llPos, llOn = Camera:WorldToViewportPoint(leftLeg.Position)
                                        if torsoOn and llOn then
                                            data.SkeletonLines["LeftLeg_Torso"].From = Vector2.new(torsoPos.X, torsoPos.Y)
                                            data.SkeletonLines["LeftLeg_Torso"].To = Vector2.new(llPos.X, llPos.Y)
                                            data.SkeletonLines["LeftLeg_Torso"].Color = activeESPColor
                                            data.SkeletonLines["LeftLeg_Torso"].Visible = true
                                        else
                                            data.SkeletonLines["LeftLeg_Torso"].Visible = false
                                        end
                                    end

                                    if rightLeg then
                                        local rlPos, rlOn = Camera:WorldToViewportPoint(rightLeg.Position)
                                        if torsoOn and rlOn then
                                            data.SkeletonLines["RightLeg_Torso"].From = Vector2.new(torsoPos.X, torsoPos.Y)
                                            data.SkeletonLines["RightLeg_Torso"].To = Vector2.new(rlPos.X, rlPos.Y)
                                            data.SkeletonLines["RightLeg_Torso"].Color = activeESPColor
                                            data.SkeletonLines["RightLeg_Torso"].Visible = true
                                        else
                                            data.SkeletonLines["RightLeg_Torso"].Visible = false
                                        end
                                    end
                                else
                                    for _, l in pairs(data.SkeletonLines) do l.Visible = false end
                                end
                            else
                                for _, l in pairs(data.SkeletonLines) do l.Visible = false end
                            end
                        end
                    end
                end
            end
        end
    end)
end)
