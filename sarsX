-- ESP Cache ve Yönetimi
local espCache = {}

local function removeESP(player)
    pcall(function()
        if espCache[player] then
            if espCache[player].Highlight then espCache[player].Highlight:Destroy() end
            if espCache[player].Billboard then espCache[player].Billboard:Destroy() end
            if espCache[player].Line then pcall(function() espCache[player].Line:Remove() end) end
            if espCache[player].BoxOutline then pcall(function() espCache[player].BoxOutline:Remove() end) end
            if espCache[player].BoxInline then pcall(function() espCache[player].BoxInline:Remove() end) end
            if espCache[player].HealthBarOutline then pcall(function() espCache[player].HealthBarOutline:Remove() end) end
            if espCache[player].HealthBarInline then pcall(function() espCache[player].HealthBarInline:Remove() end) end
            if espCache[player].SkeletonLines then
                for _, line in pairs(espCache[player].SkeletonLines) do
                    pcall(function() line:Remove() end)
                end
            end
            espCache[player] = nil
        end
    end)
end

local function setupESP(player)
    if player == LocalPlayer then return end
    removeESP(player)

    local function applyToCharacter(char)
        pcall(function()
            removeESP(player)
            local humanoidRootPart = char:WaitForChild("HumanoidRootPart", 5)
            local head = char:WaitForChild("Head", 5)
            local humanoid = char:WaitForChild("Humanoid", 5)
            if not humanoidRootPart or not head or not humanoid then return end

            local highlight = Instance.new("Highlight")
            highlight.Adornee = char
            highlight.FillColor = Color3.fromRGB(255, 215, 0)
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency = 0.5
            highlight.Enabled = false
            highlight.Parent = char

            local billboard = Instance.new("BillboardGui")
            billboard.Adornee = head
            billboard.Size = UDim2.new(0, 200, 0, 50)
            billboard.StudsOffset = Vector3.new(0, 2.5, 0)
            billboard.AlwaysOnTop = true
            billboard.Enabled = false

            local textLabel = Instance.new("TextLabel")
            textLabel.Parent = billboard
            textLabel.BackgroundTransparency = 1
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.Font = Enum.Font.FredokaOne
            textLabel.TextSize = 13
            textLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
            textLabel.TextStrokeTransparency = 0
            textLabel.Text = player.Name
            billboard.Parent = char

            local tracerLine = Drawing.new("Line")
            tracerLine.Visible = false
            tracerLine.Thickness = 1.5

            local boxOutline = Drawing.new("Square")
            boxOutline.Visible = false
            boxOutline.Thickness = 3
            boxOutline.Filled = false
            boxOutline.Color = Color3.fromRGB(0, 0, 0)

            local boxInline = Drawing.new("Square")
            boxInline.Visible = false
            boxInline.Thickness = 1.5
            boxInline.Filled = false

            local healthBarOutline = Drawing.new("Line")
            healthBarOutline.Visible = false
            healthBarOutline.Thickness = 3
            healthBarOutline.Color = Color3.fromRGB(0, 0, 0)

            local healthBarInline = Drawing.new("Line")
            healthBarInline.Visible = false
            healthBarInline.Thickness = 1
            healthBarInline.Color = Color3.fromRGB(0, 255, 0)

            -- R6 İskelet Bağlantıları
            local skeletonBones = {
                "Head_Torso",
                "LeftArm_Torso",
                "RightArm_Torso",
                "LeftLeg_Torso",
                "RightLeg_Torso"
            }
            local skeletonLines = {}
            for _, boneName in ipairs(skeletonBones) do
                local l = Drawing.new("Line")
                l.Visible = false
                l.Thickness = 1.5
                skeletonLines[boneName] = l
            end

            espCache[player] = {
                Highlight = highlight,
                Billboard = billboard,
                Text = textLabel,
                Line = tracerLine,
                BoxOutline = boxOutline,
                BoxInline = boxInline,
                HealthBarOutline = healthBarOutline,
                HealthBarInline = healthBarInline,
                SkeletonLines = skeletonLines,
                Character = char,
                Humanoid = humanoid,
                RootPart = humanoidRootPart,
                Head = head
            }
        end)
    end

    player.CharacterAdded:Connect(applyToCharacter)
    if player.Character then
        task.spawn(function() applyToCharacter(player.Character) end)
    end
end

for _, p in ipairs(Players:GetPlayers()) do setupESP(p) end
Players.PlayerAdded:Connect(setupESP)
Players.PlayerRemoving:Connect(removeESP)

